# Copy to .env (git-ignored). llm.py reads this file; real environment variables take precedence.
# Pick ONE of the two blocks.

# A) Hosted, free: key from https://build.nvidia.com (40 requests/min, shared, 3-70 s per answer)
NVIDIA_API_KEY=

# B) Local through Ollama (https://ollama.com): 2-4 s per answer on a 16 GB GPU with gemma3:12b,
#    ~15-25 s on CPU with gemma3:4b. setup.ps1 / setup.sh fill these in for you.
#NAVIGATOR_LLM_BASE=http://127.0.0.1:11434/v1
#NAVIGATOR_LLM_KEY=ollama
#NAVIGATOR_LLM_MODEL=gemma3:12b
